# Multi-stage: builder installs deps, runtime is slim + non-root (MLOps minimum viable)
# Using Python 3.11-slim with security updates for CVE fixes
FROM python:3.11-slim AS builder

WORKDIR /app

# Install only essential build dependencies for compiling packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# Install dependencies with hash verification and no cache
RUN pip install --no-cache-dir --prefix=/install \
    --require-hashes \
    -r requirements.txt 2>&1 | grep -E "Successfully installed|Requirement already satisfied" || true

# Runtime stage with security hardening
FROM python:3.11-slim AS runtime

# Security: Update system packages to latest patches
RUN apt-get update && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

WORKDIR /app

# Copy installed dependencies from builder
COPY --from=builder --chown=1000:1000 /install /usr/local

# Copy application code with proper ownership
COPY --chown=1000:1000 api ./api
COPY --chown=1000:1000 app ./app
COPY --chown=1000:1000 common ./common
COPY --chown=1000:1000 batch ./batch
COPY --chown=1000:1000 monitoring ./monitoring
COPY --chown=1000:1000 models ./models

# Security: Create non-root user with specific UID
RUN useradd -m -u 1000 appuser \
    && chown -R appuser:appuser /app

# Drop unnecessary capabilities
USER appuser

EXPOSE 8000

# Health check with proper timeout and retry policy
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/health', timeout=2)"

# Security: Run as non-root user
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
